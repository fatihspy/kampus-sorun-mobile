{
  "expo": {
    "name": "Kampüs Sorun Bildirim",
    "slug": "kampus-sorun-bildirim",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Kampüsteki sorunların fotoğrafını çekebilmek için kameraya erişim gerekiyor.",
        "NSLocationWhenInUseUsageDescription": "Sorunun konumunu otomatik ekleyebilmek için konumunuza ihtiyacımız var."
      }
    },
    "android": {
      "package": "com.fatihspy.kampussorunbildirim",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logos/ege-universitesi.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4ad9f492-9335-44a2-a5d9-1e25530f0214"
      }
    }
  }
}
